# PayPal sandbox only — server only
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Channel3 — server only
CHANNEL3_API_KEY=
# P0 — used by POST /api/drops/:id/plan via server/src/planner.ts
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Payout recipients (sandbox emails; each share needs a different account, not the merchant)
PAYOUT_CREATOR_EMAIL=
PAYOUT_SUPPLIER_EMAIL=
PAYOUT_PLATFORM_EMAIL=
# Postgres (required at startup). Render sets this automatically from its database.
DATABASE_URL=
# Daily Channel3 price re-check (Render cron): run with the same DATABASE_URL and CHANNEL3_API_KEY
# Trial licence keys for the browser, served via GET /api/client-config (public trial keys, not secrets)
AG_GRID_LICENSE_KEY=
BRYNTUM_LICENSE_KEY=
