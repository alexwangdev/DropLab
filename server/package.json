{
  "name": "droplab-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/rules.test.ts test/negotiate.test.ts test/routes.test.ts test/channel3-mcp.test.ts test/waterfall.test.ts test/substitute.test.ts test/evidence.test.ts",
    "verify": "tsx scripts/verify.ts",
    "trace:all": "tsx scripts/apimatic-trace-all.ts",
    "trace": "tsx scripts/apimatic-trace-all.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^4.104.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
